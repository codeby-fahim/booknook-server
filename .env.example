# MongoDB connection string (database name "wanderlust" is selected in code)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Frontend / auth service base URL.
# JWKS is fetched from: ${CLIENT_URL}/api/auth/jwks
CLIENT_URL=http://localhost:3000

# Local server port (optional, defaults to 5000)
PORT=5000



 